			const languageButtons = document.querySelectorAll("[data-lang]");
			let currentLang = null; // Track current language to avoid re-applying

			const applyLanguage = (lang) => {
				const selected = translations[lang] ? lang : "es";
				
				// Evitar aplicar el mismo idioma dos veces
				if (currentLang === selected) return;
				currentLang = selected;

				document.documentElement.lang = selected;
				document.title = translations[selected]["site.title"] ?? document.title;

				document.querySelectorAll("[data-i18n]").forEach((el) => {
					const key = el.getAttribute("data-i18n");
					const value = translations[selected][key];
					if (value) {
						el.textContent = value;
					}
				});

				document.querySelectorAll("[data-i18n-html]").forEach((el) => {
					const key = el.getAttribute("data-i18n-html");
					const value = translations[selected][key];
					if (value) {
						el.innerHTML = value;
					}
				});

				languageButtons.forEach((button) => {
					const isActive = button.getAttribute("data-lang") === selected;
					button.setAttribute("aria-pressed", isActive ? "true" : "false");
					button.classList.toggle("bg-gray-900", isActive);
					button.classList.toggle("text-white", isActive);
					button.classList.toggle("border-gray-900", isActive);
				});

				localStorage.setItem("language", selected);
			};

			// Expose for other components (e.g. LanguageSwitcher modal)
			window.applyLanguage = applyLanguage;

			languageButtons.forEach((button) => {
				button.addEventListener("click", () => {
					applyLanguage(button.getAttribute("data-lang"));
				});
			});

			const storedLanguage = localStorage.getItem("language");
			if (storedLanguage) {
				// Solo aplicar si hay un idioma guardado
				applyLanguage(storedLanguage);
			}
			// Si NO hay idioma guardado, dejar que LanguageSwitcher maneje el modal
			// y NO aplicar idioma por defecto hasta que el usuario seleccione
